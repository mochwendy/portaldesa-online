{
    "name": "RealisasiPembangunan",
    "type": "object",
    "properties": {
      "nama_kegiatan": {
        "type": "string",
        "title": "Nama Kegiatan"
      },
      "tahun_anggaran": {
        "type": "number",
        "title": "Tahun Anggaran",
        "default": 2026
      },
      "sumber_dana": {
        "type": "string",
        "enum": [
          "Dana Desa",
          "APBD",
          "APBN",
          "PADes",
          "Lainnya"
        ],
        "title": "Sumber Dana",
        "default": "Dana Desa"
      },
      "anggaran": {
        "type": "number",
        "title": "Anggaran (Rp)",
        "default": 0
      },
      "realisasi_anggaran": {
        "type": "number",
        "title": "Realisasi Anggaran (Rp)",
        "default": 0
      },
      "persentase_progress": {
        "type": "number",
        "title": "Persentase Progress (%)",
        "default": 0,
        "minimum": 0,
        "maximum": 100
      },
      "status": {
        "type": "string",
        "enum": [
          "Belum Mulai",
          "Persiapan",
          "Pelaksanaan",
          "Selesai",
          "Tertunda"
        ],
        "title": "Status",
        "default": "Belum Mulai"
      },
      "lokasi": {
        "type": "string",
        "title": "Lokasi Kegiatan"
      },
      "pelaksana": {
        "type": "string",
        "title": "Pelaksana / Kontraktor"
      },
      "tanggal_mulai": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Mulai"
      },
      "tanggal_selesai": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Selesai"
      },
      "foto_0_uri": {
        "type": "string",
        "title": "Foto Progress 0%"
      },
      "foto_50_uri": {
        "type": "string",
        "title": "Foto Progress 50%"
      },
      "foto_100_uri": {
        "type": "string",
        "title": "Foto Progress 100%"
      },
      "catatan": {
        "type": "string",
        "title": "Catatan"
      }
    },
    "required": [
      "nama_kegiatan",
      "sumber_dana",
      "anggaran"
    ]
  }