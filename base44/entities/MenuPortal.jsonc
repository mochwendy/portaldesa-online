{
    "name": "MenuPortal",
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "title": "Label Menu"
      },
      "path": {
        "type": "string",
        "title": "Path / URL"
      },
      "icon": {
        "type": "string",
        "title": "Nama Icon (Lucide)",
        "description": "Nama icon lucide-react, contoh: Home, FileText"
      },
      "urutan": {
        "type": "number",
        "title": "Urutan Tampil",
        "default": 0
      },
      "published": {
        "type": "boolean",
        "title": "Dipublikasi",
        "default": true
      },
      "is_external": {
        "type": "boolean",
        "title": "Link Eksternal",
        "default": false
      },
      "kategori": {
        "type": "string",
        "enum": [
          "menu_utama",
          "menu_footer"
        ],
        "title": "Kategori Menu",
        "default": "menu_utama"
      }
    },
    "required": [
      "label",
      "path"
    ]
  }