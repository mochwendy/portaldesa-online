{
    "name": "SuratKeterangan",
    "type": "object",
    "properties": {
      "nomor_surat": {
        "type": "string",
        "title": "Nomor Surat"
      },
      "nik_pemohon": {
        "type": "string",
        "title": "NIK Pemohon"
      },
      "nama_pemohon": {
        "type": "string",
        "title": "Nama Pemohon"
      },
      "no_telepon": {
        "type": "string",
        "title": "Nomor Telepon/WhatsApp",
        "description": "Nomor WhatsApp warga untuk notifikasi status surat"
      },
      "jenis_surat": {
        "type": "string",
        "title": "Jenis Surat"
      },
      "keperluan": {
        "type": "string",
        "title": "Keperluan"
      },
      "tanggal_pengajuan": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Pengajuan"
      },
      "tanggal_selesai": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Selesai"
      },
      "status": {
        "type": "string",
        "enum": [
          "Diajukan",
          "Diproses",
          "Disetujui",
          "Ditolak",
          "Selesai"
        ],
        "title": "Status",
        "default": "Diajukan"
      },
      "catatan": {
        "type": "string",
        "title": "Catatan"
      },
      "channel": {
        "type": "string",
        "enum": [
          "Portal",
          "Loket Desa"
        ],
        "title": "Saluran Permohonan",
        "default": "Portal"
      },
      "tanggal_surat": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Surat"
      },
      "isi_surat": {
        "type": "string",
        "title": "Isi Surat (HTML)"
      },
      "extras_json": {
        "type": "string",
        "title": "Data Tambahan Template (JSON)"
      },
      "pejabat_id": {
        "type": "string",
        "title": "ID Pejabat Penandatangan"
      },
      "pejabat_nama": {
        "type": "string",
        "title": "Nama Pejabat Penandatangan"
      },
      "pejabat_jabatan": {
        "type": "string",
        "title": "Jabatan Penandatangan"
      },
      "atas_nama": {
        "type": "boolean",
        "title": "Atas Nama Kepala Desa",
        "default": false
      },
      "tipe_ttd": {
        "type": "string",
        "enum": [
          "Digital",
          "QR",
          "Manual"
        ],
        "enumColors": [
          "blue",
          "green",
          "gray"
        ],
        "title": "Tipe Tanda Tangan",
        "default": "Manual"
      },
      "kode_verifikasi": {
        "type": "string",
        "title": "Kode Verifikasi QR",
        "description": "Kode unik yang tertanam pada QR untuk validasi keaslian surat"
      },
      "waktu_ttd": {
        "type": "string",
        "format": "date-time",
        "title": "Waktu Penandatanganan Elektronik"
      },
      "pdf_file_uri": {
        "type": "string",
        "title": "Berkas PDF Surat",
        "description": "File URI PDF surat bertanda tangan QR yang dibagikan ke warga saat status Selesai"
      }
    },
    "required": [
      "nik_pemohon",
      "nama_pemohon",
      "jenis_surat",
      "tanggal_pengajuan"
    ]
  }