{
    "name": "Penduduk",
    "type": "object",
    "properties": {
      "nik": {
        "type": "string",
        "title": "NIK",
        "description": "Nomor Induk Kependudukan (16 digit)"
      },
      "no_kk": {
        "type": "string",
        "title": "Nomor Kartu Keluarga",
        "description": "Nomor KK sesuai data kependudukan desa"
      },
      "nama_lengkap": {
        "type": "string",
        "title": "Nama Lengkap"
      },
      "jenis_kelamin": {
        "type": "string",
        "enum": [
          "Laki-laki",
          "Perempuan",
          "Tidak Diisi"
        ],
        "enumColors": [
          "blue",
          "pink",
          "gray"
        ],
        "title": "Jenis Kelamin",
        "default": "Laki-laki"
      },
      "tempat_lahir": {
        "type": "string",
        "title": "Tempat Lahir"
      },
      "tanggal_lahir": {
        "type": "string",
        "format": "date",
        "title": "Tanggal Lahir"
      },
      "kelompok_usia": {
        "type": "string",
        "enum": [
          "0-5 Tahun",
          "6-14 Tahun",
          "15-24 Tahun",
          "25-44 Tahun",
          "45-64 Tahun",
          "65+ Tahun",
          "Tidak Diketahui"
        ],
        "enumColors": [
          "blue",
          "blue",
          "green",
          "green",
          "yellow",
          "purple",
          "gray"
        ],
        "title": "Kelompok Usia",
        "default": "Tidak Diketahui"
      },
      "agama": {
        "type": "string",
        "enum": [
          "Islam",
          "Kristen",
          "Katolik",
          "Hindu",
          "Buddha",
          "Konghucu",
          "Lainnya",
          "Tidak Diisi"
        ],
        "enumColors": [
          "green",
          "blue",
          "blue",
          "purple",
          "yellow",
          "pink",
          "gray",
          "gray"
        ],
        "title": "Agama",
        "default": "Islam"
      },
      "pendidikan": {
        "type": "string",
        "enum": [
          "Tidak/Belum Sekolah",
          "Belum Tamat SD",
          "SD",
          "SMP",
          "SMA/SMK",
          "Diploma",
          "S1",
          "S2/S3",
          "Lainnya"
        ],
        "enumColors": [
          "gray",
          "gray",
          "yellow",
          "yellow",
          "green",
          "blue",
          "purple",
          "pink",
          "gray"
        ],
        "title": "Pendidikan Terakhir"
      },
      "pekerjaan": {
        "type": "string",
        "title": "Pekerjaan"
      },
      "status_perkawinan": {
        "type": "string",
        "enum": [
          "Belum Kawin",
          "Kawin",
          "Cerai Hidup",
          "Cerai Mati",
          "Tidak Diisi"
        ],
        "enumColors": [
          "blue",
          "green",
          "yellow",
          "red",
          "gray"
        ],
        "title": "Status Perkawinan"
      },
      "status_keluarga": {
        "type": "string",
        "enum": [
          "Kepala Keluarga",
          "Istri",
          "Anak",
          "Menantu",
          "Cucu",
          "Orang Tua",
          "Mertua",
          "Famili Lain",
          "Lainnya"
        ],
        "enumColors": [
          "green",
          "pink",
          "blue",
          "blue",
          "blue",
          "yellow",
          "yellow",
          "gray",
          "gray"
        ],
        "title": "Status Hubungan dalam Keluarga",
        "default": "Lainnya"
      },
      "status_rumah": {
        "type": "string",
        "title": "Status Kepemilikan Rumah"
      },
      "disabilitas": {
        "type": "string",
        "title": "Disabilitas"
      },
      "listrik": {
        "type": "string",
        "title": "Daya / Sambungan Listrik"
      },
      "alamat": {
        "type": "string",
        "title": "Alamat (Kampung)"
      },
      "rt": {
        "type": "string",
        "title": "RT"
      },
      "rw": {
        "type": "string",
        "title": "RW"
      },
      "no_wa": {
        "type": "string",
        "title": "No. WhatsApp / HP",
        "description": "Nomor WhatsApp/HP warga (opsional), format: 628xxxxxxxxxx"
      },
      "status_kependudukan": {
        "type": "string",
        "enum": [
          "Aktif",
          "Pindah",
          "Meninggal",
          "Perantau"
        ],
        "enumColors": [
          "green",
          "yellow",
          "red",
          "blue"
        ],
        "title": "Status Kependudukan",
        "default": "Aktif"
      },
      "sumber_data": {
        "type": "string",
        "title": "Sumber Data"
      }
    },
    "required": [
      "nik",
      "nama_lengkap",
      "jenis_kelamin"
    ],
    "rls": {
      "read": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "create": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "update": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "delete": {
        "$or": [
          {
            "created_by_id": "{{user.id}}"
          },
          {
            "user_condition": {
              "role": "admin"
            }
          }
        ]
      }
    }
  }