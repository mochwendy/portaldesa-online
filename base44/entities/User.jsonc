{
    "name": "User",
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "description": "Tingkat kewenangan akun: admin (Administrator) atau user (Pengguna sesuai hak akses grup)",
        "enum": [
          "admin",
          "user"
        ],
        "enumColors": [
          "red",
          "blue"
        ]
      },
      "grup_pengguna": {
        "type": "string",
        "title": "Kode Grup Pengguna",
        "description": "Kode grup pada entitas UserGroup, contoh: SU, ADM, KADES"
      },
      "status_akun": {
        "type": "string",
        "title": "Status Akun",
        "enum": [
          "Aktif",
          "Nonaktif"
        ],
        "enumColors": [
          "green",
          "red"
        ],
        "default": "Aktif"
      },
      "jabatan": {
        "type": "string",
        "title": "Jabatan / Unit Kerja"
      }
    },
    "required": [
      "role"
    ]
  }