{
    "name": "UserGroup",
    "type": "object",
    "properties": {
      "nama": {
        "type": "string",
        "title": "Nama Grup"
      },
      "kode": {
        "type": "string",
        "title": "Kode / ID Grup",
        "description": "Contoh: SU, ADM, KADES"
      },
      "deskripsi": {
        "type": "string",
        "title": "Deskripsi Grup"
      },
      "is_admin": {
        "type": "boolean",
        "title": "Is Admin",
        "default": false
      },
      "required_app_id": {
        "type": "boolean",
        "title": "Required Application ID",
        "default": false
      },
      "bawaan_sistem": {
        "type": "boolean",
        "title": "Grup Bawaan Sistem",
        "default": false
      },
      "permissions": {
        "type": "string",
        "title": "Hak Akses (JSON)",
        "description": "Peta hak akses per modul: {\"penduduk\":{\"view\":true,\"create\":true,\"delete\":false}}"
      },
      "urutan": {
        "type": "number",
        "title": "Urutan Tampil",
        "default": 0
      }
    },
    "required": [
      "nama",
      "kode"
    ],
    "rls": {
      "read": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "create": {
        "user_condition": {
          "role": "admin"
        }
      },
      "update": {
        "user_condition": {
          "role": "admin"
        }
      },
      "delete": {
        "user_condition": {
          "role": "admin"
        }
      }
    }
  }