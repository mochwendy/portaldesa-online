{
    "name": "WebsiteSetting",
    "type": "object",
    "properties": {
      "logo_url": {
        "type": "string",
        "title": "URL Logo Website"
      },
      "warna_primary": {
        "type": "string",
        "title": "Warna Utama (HEX)"
      },
      "warna_accent": {
        "type": "string",
        "title": "Warna Aksen (HEX)"
      },
      "font_judul": {
        "type": "string",
        "enum": [
          "Plus Jakarta Sans",
          "Inter",
          "Poppins",
          "Merriweather"
        ],
        "enumColors": [
          "blue",
          "green",
          "purple",
          "yellow"
        ],
        "title": "Font Judul",
        "default": "Plus Jakarta Sans"
      },
      "font_isi": {
        "type": "string",
        "enum": [
          "Plus Jakarta Sans",
          "Inter",
          "Poppins",
          "Merriweather"
        ],
        "enumColors": [
          "blue",
          "green",
          "purple",
          "yellow"
        ],
        "title": "Font Isi",
        "default": "Plus Jakarta Sans"
      },
      "gaya_hero": {
        "type": "string",
        "enum": [
          "tengah",
          "kiri",
          "polos"
        ],
        "enumColors": [
          "blue",
          "green",
          "gray"
        ],
        "title": "Gaya Header Beranda",
        "default": "tengah"
      },
      "hero_badge": {
        "type": "string",
        "title": "Sapaan Pembuka Header"
      },
      "hero_judul": {
        "type": "string",
        "title": "Judul Header Beranda"
      },
      "hero_deskripsi": {
        "type": "string",
        "title": "Narasi Selamat Datang"
      },
      "footer_narasi": {
        "type": "string",
        "title": "Narasi Footer"
      },
      "footer_alamat": {
        "type": "string",
        "title": "Alamat Kantor Desa (Footer)"
      },
      "footer_telepon": {
        "type": "string",
        "title": "Telepon / WhatsApp (Footer)"
      },
      "footer_email": {
        "type": "string",
        "title": "Email Resmi Desa (Footer)"
      },
      "footer_links": {
        "type": "string",
        "title": "Tautan Footer (JSON)"
      },
      "footer_copyright": {
        "type": "string",
        "title": "Teks Hak Cipta Footer"
      }
    },
    "rls": {
      "read": {},
      "create": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "update": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "user_condition": {
              "role": "user"
            }
          }
        ]
      },
      "delete": {
        "user_condition": {
          "role": "admin"
        }
      }
    },
    "required": []
  }